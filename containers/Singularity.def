Bootstrap: docker
From: python:3.11-slim

%files
    requirements-lock.txt /opt/phecodex/requirements-lock.txt
    pyproject.toml /opt/phecodex/pyproject.toml
    README.md /opt/phecodex/README.md
    ANALYST_GUIDE.md /opt/phecodex/ANALYST_GUIDE.md
    src /opt/phecodex/src
    scripts/verify_release.py /opt/phecodex/scripts/verify_release.py
    scripts/prepare_ukb_for_mapping.R /opt/phecodex/scripts/prepare_ukb_for_mapping.R
    scripts/plot_phecode_attrition.py /opt/phecodex/scripts/plot_phecode_attrition.py
    scripts/package_distribution.py /opt/phecodex/scripts/package_distribution.py
    scripts/check_prevalence.py /opt/phecodex/scripts/check_prevalence.py
    scripts/check_deidentification.py /opt/phecodex/scripts/check_deidentification.py
    scripts/reconcile_attrition.py /opt/phecodex/scripts/reconcile_attrition.py
    scripts/deidentify_ukb_for_testing.R /opt/phecodex/scripts/deidentify_ukb_for_testing.R

%post
    cd /opt/phecodex
    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir -r requirements-lock.txt
    python -m pip install --no-cache-dir .
    python -m pip cache purge

%environment
    export PHECODEX_HOME=/opt/phecodex
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%runscript
    exec phecodex-map "$@"

%labels
    Author PhecodeX consortium
    Description Pinned PhecodeX analyst mapper
